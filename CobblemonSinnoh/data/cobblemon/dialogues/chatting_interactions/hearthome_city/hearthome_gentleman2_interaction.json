    {
      "id": "page2",
      "speaker": "npc",
      "lines": [
        "Indeed, yes I am! When you wish to treat your Pokémon to a treat, what, I say, do you do?"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Next",
            "value": "next",
