    },
    {
      "id": "page4",
      "speaker": "npc",
      "lines": [
        "Because the giving of Poffins is a way of expressing your love! For example!"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Next",
            "value": "next",
            "action": "q.dialogue.set_page('page5');"
