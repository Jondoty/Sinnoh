{   
    "speakers": {
        "player": {
         "face": "q.player.face(true);",
         "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
      },
    "pages": [
        {
            "id": "greeting",
            "speaker": "player",
            "lines": [
                "Would you like to enter the Grand Underground?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function sinnoh:underground/dig');",
                            "q.dialogue.close();"
                    ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        }
        ]
    }