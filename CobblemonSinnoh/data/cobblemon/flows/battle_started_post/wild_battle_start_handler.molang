c.battle.is_pvw == false ? return 0;

for_each(t.player, c.players, {
    v.player = t.player.player;
    q.set_query('player', t.player.player);

    q.run_command('execute as ' + q.player.username + ' run scoreboard players set @s BattleStart 40');
    q.run_command('execute as ' + q.player.username + ' unless entity @s[tag=Skip] run function sinnoh:triggers/stopsound');
    q.run_command('execute as ' + q.player.username + ' run tag @s remove Skip');
});